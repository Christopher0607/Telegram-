# systemd 方式运行（不用 Docker 时）：
#   sudo cp deploy/tgtrader.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now tgtrader
#   journalctl -u tgtrader -f
[Unit]
Description=Telegram signal copy-trading bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tgtrader
WorkingDirectory=/opt/tgtrader
ExecStart=/opt/tgtrader/.venv/bin/python -m tgtrader.main
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
