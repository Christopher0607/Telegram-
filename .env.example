# 复制为 .env 并填写：  cp .env.example .env && chmod 600 .env

# ---- Telegram 用户账号 API（在 https://my.telegram.org -> API development tools 申请）----
TG_API_ID=
TG_API_HASH=
TG_PHONE=+86xxxxxxxxxxx
TG_SESSION=data/tg

# ---- 交易所 API（只开「合约交易」权限，不要开提现！建议绑定服务器 IP 白名单）----
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# OKX / Bitget 需要 passphrase
EXCHANGE_API_PASSWORD=

# 覆盖 config.yaml 里的 dry_run（留空则以 config.yaml 为准）
DRY_RUN=

# 可选：Claude 解析（llm.enabled: true 时需要）
ANTHROPIC_API_KEY=
